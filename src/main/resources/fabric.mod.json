{
	"schemaVersion": 1,
	"id": "eutil",
	"version": "${version}",
	"name": "EarthMC Utils",
	"description": "EarthMC向けのユーティリティMod。とあるとこのBotの機能が移植されたものです。",
	"authors": [
		"ぱるん"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/eutils/",
		"sources": "https://github.com/Pa1n2l/EarthMC_Utils"
	},
	"license": "CC BY-NC 4.0",
	"icon": "assets/eutil/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.paln21.eutil.EUtil"
		],
		"client": [
			"com.paln21.eutil.client.EUtilClient"
		],
		"modmenu": [
			"com.paln21.eutil.client.EUtilModMenuIntegration"
		]
	},
	"mixins": [
		"eutil.mixins.json",
		{
			"config": "eutil.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"modmenu": ">=17.0.0-alpha.1"
	}
}